#!/bin/bash
export DISPLAY=:1

# Disable glycin sandbox (crashes in containers trying to use bwrap)
export GLYCIN_SANDBOX=off

# Set Chrome as default browser
export BROWSER="google-chrome --no-sandbox"
xdg-settings set default-web-browser google-chrome.desktop 2>/dev/null || true

# Disable screensaver
xset s off
xset -dpms
xset s noevent

# Start dbus session (required for XFCE components)
eval $(dbus-launch --sh-syntax)
export DBUS_SESSION_BUS_ADDRESS

# Start window manager
xfwm4 --compositor=off &
sleep 1

# Start panel (taskbar with window list)
xfce4-panel &
sleep 1

# Start desktop (shows icons)
xfdesktop &
sleep 2

# Mark desktop shortcuts as trusted
chmod +x /home/kiro/Desktop/*.desktop 2>/dev/null
gio set /home/kiro/Desktop/Kiro.desktop metadata::trusted true 2>/dev/null || true
gio set /home/kiro/Desktop/Chrome.desktop metadata::trusted true 2>/dev/null || true

# Launch Kiro IDE
kiro --no-sandbox /home/kiro/workspace > /tmp/kiro.log 2>&1 &

# Keep alive
while true; do sleep 60; done
